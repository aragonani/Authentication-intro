<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %></title>
</head>
<body>

    <p><a href="/product">Back to All Products</a></p>
    <hr>

    <h1><%= product.title %></h1>

    <% if (product.image) { %>
        <img src="<%= product.image %>" alt="<%= product.title %>" width="300">
        <br><br>
    <% } %>

    <p><b>Price:</b> $<%= product.price %></p>
    <p><b>Description:</b> <%= product.description %></p>

    <!-- Protected actions for logged-in users only -->
    <% if (user) { %>
        <hr>
        <a href="/product/<%= product._id %>/edit">Edit this Product</a>
        |
        <form action="/product/<%= product._id %>/delete" method="post" style="display:inline;">
            <button type="submit">Delete this Product</button>
        </form>
    <% } %>

</body>
</html>
