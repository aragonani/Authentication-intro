<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
</head>
<body>

    <!-- Navigation / Auth status -->
    <div>
        <% if (user) { %>
            <p>Logged in as: <b><%= user.name %></b> (<%= user.email %>) | <a href="/user/logout">Logout</a></p>
        <% } else { %>
            <p><a href="/login">Login</a> | <a href="/register">Register</a></p>
        <% } %>
    </div>

    <hr>

    <!-- Add Product Form (Logged-in users only) -->
    <% if (user) { %>
        <h2>Add Product</h2>
        <form action="/product" method="post">
            <div>
                <label>Product Name:</label>
                <input type="text" name="title" placeholder="Name" required>
            </div>
            <br>
            <div>
                <label>Price:</label>
                <input type="number" step="0.01" name="price" placeholder="Price" required>
            </div>
            <br>
            <div>
                <label>Image URL:</label>
                <input type="text" name="image" placeholder="Image URL">
            </div>
            <br>
            <div>
                <label>Description:</label>
                <textarea name="description" placeholder="Description"></textarea>
            </div>
            <br>
            <button type="submit">Add Product</button>
        </form>
        <hr>
    <% } %>

    <!-- Products List (Public: anyone can view) -->
    <h2>All Products</h2>

    <% if (todos && todos.length > 0) { %>
        <% todos.forEach(product => { %>
            <div style="border: 1px solid black; padding: 10px; margin-bottom: 10px;">
                <% if (product.image) { %>
                    <img src="<%= product.image %>" alt="<%= product.title %>" width="150">
                    <br>
                <% } %>
                <h3><%= product.title %></h3>
                <p>Price: $<%= product.price %></p>
                <p><%= product.description %></p>

                <!-- Public link -->
                <a href="/product/<%= product._id %>">View Details</a>

                <!-- Protected buttons for logged-in users only -->
                <% if (user) { %>
                    | <a href="/product/<%= product._id %>/edit">Edit</a>
                    | 
                    <form action="/product/<%= product._id %>/delete" method="post" style="display:inline;">
                        <button type="submit">Delete</button>
                    </form>
                <% } %>
            </div>
        <% }) %>
    <% } else { %>
        <p>No products found.</p>
    <% } %>

</body>
</html>